{
  "name": "ecmascript-parser-benchmark-js",
  "type": "module",
  "private": true,
  "scripts": {
    "bench": "node scripts/bench.ts && pnpm run readme",
    "load-files": "node scripts/load-files.ts",
    "bench:typescript": "node scripts/bench.ts typescript",
    "bench:checker": "node scripts/bench.ts checker",
    "bench:lib_dom": "node scripts/bench.ts lib_dom",
    "bench:react": "node scripts/bench.ts react",
    "readme": "node scripts/generate-readme.ts",
    "update-parsers": "pnpm update --latest",
    "type-check": "tsgo --noEmit",
    "preflight": "node scripts/preflight.ts",
    "test:normalize": "node --test scripts/compare-parse-result/normalize-parse-result.test.ts",
    "test:benchmark": "node --test scripts/benchmark-parsers.test.ts"
  },
  "dependencies": {
    "@babel/parser": "^8.1.0",
    "@swc-next/parser": "^0.6.1",
    "@swc/core": "^1.16.22",
    "acorn": "^8.19.0",
    "oxc-parser": "^0.158.0",
    "tinybench": "^6.2.2",
    "yuku": "^0.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.28.11"
}
